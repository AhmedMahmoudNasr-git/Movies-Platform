<%- include('../../partials/siteHeader') %>

<div class="container my-5" style="max-width: 480px;">
    <div class="card card-dark rounded-4 p-4 p-md-5 shadow-lg">
        <div class="text-center mb-4">
            <h2 class="fw-bold mb-1 text-white">Sign In</h2>
            <p class="small" style="color: #94A3B8;">Welcome back to <span style="color: #7C3AED; font-weight: 800;">Movies</span><span style="color: #2563EB; font-weight: 800;">Hub</span></p>
        </div>

        <% if (error) { %>
            <div class="alert alert-danger py-2 mb-3 small" role="alert">
                <%= error %>
            </div>
        <% } %>

        <form action="/auth/login" method="POST">
            <input type="hidden" name="redirectUrl" value="<%= redirectUrl %>">

            <div class="mb-3">
                <label class="form-label fw-semibold">Email Address</label>
                <input type="email" name="email" class="form-control py-2" placeholder="name@example.com" required>
            </div>

            <div class="mb-4">
                <label class="form-label fw-semibold">Password</label>
                <input type="password" name="password" class="form-control py-2" placeholder="••••••••" required>
            </div>

            <button type="submit" class="btn btn-primary-custom w-100 py-2 mb-3">Sign In</button>

            <div class="text-center mt-3 small">
                <span style="color: #94A3B8;">Don't have an account? </span>
                <a href="/auth/register" style="color: #7C3AED; font-weight: 600; text-decoration: none;">Create one here</a>
            </div>
        </form>
    </div>
</div>

<%- include('../../partials/siteFooter') %>
