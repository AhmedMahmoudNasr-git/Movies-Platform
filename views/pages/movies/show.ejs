<%- include('../../partials/siteHeader.ejs') %>

<div class="container mt-5 mb-5 movie-detail-container" style="max-width: 950px;">
    
    <!-- Main Movie Details Card -->
    <div class="card card-dark movie-details-card p-4 rounded-4 shadow-lg">
        <div class="row g-4">
            <div class="col-md-4 text-center">
                <% if (movie.thumbnail) { %>
                    <img src="<%= movie.thumbnail.startsWith('http') ? movie.thumbnail : '/img/uploades/' + movie.thumbnail %>" 
                         class="img-fluid rounded-3 shadow" 
                         alt="<%= movie.title %>"
                         style="max-height: 400px; width: 100%; object-fit: cover;">
                <% } else { %>
                    <div class="rounded-3 d-flex align-items-center justify-content-center shadow-sm" style="height: 350px; background-color: #181824; color: #94A3B8;">
                        No Poster Available
                    </div>
                <% } %>
            </div>

            <div class="col-md-8 d-flex flex-column justify-content-center">
                
                <% 
                    const currentFranchise = movie.series || (typeof seriesName !== 'undefined' ? seriesName : null);
                %>
                <% if (currentFranchise && typeof seriesMovies !== 'undefined' && seriesMovies && seriesMovies.length > 1) { %>
                    <div class="mb-2">
                        <span class="badge bg-primary movie-franchise-badge text-uppercase px-3 py-2 fw-semibold" style="letter-spacing: 0.3px;">
                            🎬 <%= currentFranchise %> Franchise • <%= seriesMovies.length %> Parts Available
                        </span>
                    </div>
                <% } %>

                <div class="movie-title-row">
                    <h1 class="display-6 fw-bold mb-2 text-white"><%= movie.title %></h1>
                    <%- include('../../partials/movieFavouriteButton', { movie, favoriteMovieIds, favoritePlacement: 'favorite-toggle--detail' }) %>
                </div>
                <p class="fs-5 mb-3" style="color: #94A3B8;"><strong>Release Year:</strong> <span class="text-white"><%= movie.year %></span></p>

                <div class="mb-3">
                    <h5 class="fw-bold" style="color: #94A3B8;">Genres:</h5>
                    <p class="fs-6 fw-semibold mb-0" style="color: #7C3AED;">
                        <%= Array.isArray(movie.genres) ? movie.genres.join(', ') : movie.genres %>
                    </p>
                </div>

                <div class="mb-4">
                    <h5 class="fw-bold" style="color: #94A3B8;">Cast:</h5>
                    <p class="fs-6 mb-0 text-light">
                        <%= Array.isArray(movie.cast) ? movie.cast.join(', ') : movie.cast %>
                    </p>
                </div>

                <div class="movie-details-actions d-flex align-items-center gap-3 mt-auto">
                    <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'admin') { %>
                        <a href="/movies/<%= movie._id %>/edit" class="btn btn-warning px-4">Edit Movie</a>
                        
                        <!-- RESTful DELETE Button (Admin Only) -->
                        <form action="/movies/<%= movie._id %>?_method=DELETE" method="POST" style="margin: 0;" onsubmit="return confirm('Are you sure you want to delete this movie?');">
                            <button type="submit" class="btn btn-danger px-4">Delete</button>
                        </form>
                    <% } %>
                    
                    <!-- Smart Back Button: Restores exact category, search, and page -->
                    <a href="<%= returnTo %>" class="btn btn-secondary px-4" data-movie-return data-return-scroll="<%= returnScroll %>">
                        <span style="font-size: 1.1rem; line-height: 1;">&larr;</span> Back to Movies
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Franchise / Movie Parts List (English UI Component) -->
    <% if (typeof seriesMovies !== 'undefined' && seriesMovies && seriesMovies.length > 1) { %>
        <div class="card card-dark mt-4 rounded-4 overflow-hidden shadow-lg">
            <div class="card-header movie-series-header py-3 px-4 d-flex justify-content-between align-items-center" style="background-color: #101017; border-bottom: 1px solid var(--card-border);">
                <div class="movie-series-heading d-flex align-items-center gap-2">
                    <span style="font-size: 1.4rem;">🎞️</span>
                    <div>
                        <h5 class="mb-0 fw-bold text-white"><%= typeof seriesName !== 'undefined' && seriesName ? seriesName : (movie.series || movie.title) %> — Movie Series & Parts</h5>
                        <small style="color: #94A3B8;">All sequels in chronological order</small>
                    </div>
                </div>
                <span class="badge bg-primary movie-series-count px-3 py-2 fs-6"><%= seriesMovies.length %> Parts Available</span>
            </div>

            <div class="list-group list-group-flush">
                <% seriesMovies.forEach((part, index) => { %>
                    <% const isCurrent = part._id.toString() === movie._id.toString(); %>
                    <div class="list-group-item movie-series-item d-flex align-items-center justify-content-between py-3 px-4" 
                         style="background-color: <%= isCurrent ? '#191928' : '#14141B' %>; border-color: var(--card-border); <%= isCurrent ? 'border-left: 4px solid var(--primary) !important;' : '' %>">
                        
                        <div class="movie-series-info d-flex align-items-center gap-3">
                            <!-- Thumbnail Mini Preview -->
                            <div style="width: 48px; height: 65px; background-color: #181824; border-radius: 6px; overflow: hidden; flex-shrink: 0; border: 1px solid var(--card-border);">
                                <% if (part.thumbnail) { %>
                                    <img src="<%= part.thumbnail.startsWith('http') ? part.thumbnail : '/img/uploades/' + part.thumbnail %>" 
                                         alt="<%= part.title %>" 
                                         style="width: 100%; height: 100%; object-fit: cover;">
                                <% } else { %>
                                    <div class="d-flex align-items-center justify-content-center h-100 text-muted" style="font-size: 0.7rem;">No Pic</div>
                                <% } %>
                            </div>

                            <!-- Part Info -->
                            <div class="movie-series-action">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge <%= isCurrent ? 'bg-primary' : 'bg-secondary' %> rounded-pill px-2 py-1" style="font-size: 0.75rem;">
                                        Part <%= part.partNumber || (index + 1) %>
                                    </span>
                                    <h6 class="mb-0 fw-bold <%= isCurrent ? 'text-white' : 'text-light' %>"><%= part.title %></h6>
                                </div>
                                <small style="color: #94A3B8;">Released: <%= part.year %> • <%= Array.isArray(part.genres) ? part.genres.join(', ') : part.genres %></small>
                            </div>
                        </div>

                        <!-- Action Button -->
                        <div class="movie-series-actions">
                            <%- include('../../partials/movieFavouriteButton', { movie: part, favoriteMovieIds, favoritePlacement: 'favorite-toggle--compact' }) %>
                            <% if (isCurrent) { %>
                                <span class="badge px-3 py-2" style="background: rgba(124, 58, 237, 0.2); color: #7C3AED; border: 1px solid #7C3AED;">
                                    ✓ Currently Viewing
                                </span>
                            <% } else { %>
                                <a href="/movies/<%= part._id %>" data-movie-navigation class="btn btn-sm btn-outline-primary px-3 py-2 fw-semibold" style="border-color: #7C3AED; color: #7C3AED;">
                                    Go to Part &rarr;
                                </a>
                            <% } %>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
    <% } %>

</div>

<%- include('../../partials/siteFooter.ejs') %>
