<%- include('../../partials/siteHeader') %>

<div class="container">
    
    <!-- Title & Add Button -->
    <div class="page-header">
        <h1>Movies List</h1>
        <a href="/movies/createForm" class="btn-custom btn-primary-custom">+ Add New Movie</a>
    </div>

    <!-- Search & Filters -->
    <div class="controls-card">
        <form action="/moviesSearch" method="GET" class="search-form">
            <input 
                type="text" 
                name="partOfMovieTitle" 
                class="search-input" 
                placeholder="Search by movie title or cast name..."
            >
            <button type="submit" class="btn-custom btn-blue">Search</button>
            <a href="/movies" class="btn-custom btn-reset">Reset</a>
        </form>

        <div class="tags-group">
            <a href="/movies" class="btn-tag <%= activeGenre === 'all' ? 'active' : '' %>">All Recent</a>
            <a href="/movies/genre/action" class="btn-tag <%= activeGenre === 'action' ? 'active' : '' %>">Action</a>
            <a href="/movies/genre/drama" class="btn-tag <%= activeGenre === 'drama' ? 'active' : '' %>">Drama</a>
            <a href="/movies/genre/comedy" class="btn-tag <%= activeGenre === 'comedy' ? 'active' : '' %>">Comedy</a>
        </div>
    </div>

    <!-- Movies Grid Display -->
    <% if (movies && movies.length > 0) { %>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1.5rem;">
            <% movies.forEach(movie => { %>
                <div style="background: #fff; border: 1px solid #e2e8f0; border-radius: 10px; overflow: hidden; display: flex; flex-direction: column; box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1);">
                    
                    <div style="height: 250px; background-color: #cbd5e1; display: flex; align-items: center; justify-content: center; overflow: hidden;">
                        <% if (movie.thumbnail) { %>
                            <img src="<%= movie.thumbnail.startsWith('http') ? movie.thumbnail : '/img/uploades/' + movie.thumbnail %>" 
                                 alt="<%= movie.title %>" 
                                 style="width: 100%; height: 100%; object-fit: cover;">
                        <% } else { %>
                            <span style="color: #64748b; font-size: 0.9rem;">No Image</span>
                        <% } %>
                    </div>

                    <div style="padding: 1rem; flex: 1; display: flex; flex-direction: column; justify-content: space-between;">
                        <div>
                            <h3 style="font-size: 1.1rem; margin-bottom: 0.5rem; color: #0f172a;"><%= movie.title %></h3>
                            <p style="font-size: 0.85rem; color: #64748b; margin-bottom: 0.5rem;">
                                <strong>Year:</strong> <%= movie.year %>
                            </p>
                            <p style="font-size: 0.8rem; color: #2563eb; margin-bottom: 1rem;">
                                <%= Array.isArray(movie.genres) ? movie.genres.join(', ') : (movie.genres || '') %>
                            </p>
                        </div>

                        <div style="display: flex; gap: 5px;">
                            <a href="/movies/show/<%= movie._id %>" class="btn-custom btn-blue" style="flex: 1; padding: 0.4rem; font-size: 0.85rem; text-align: center;">View</a>
                            <a href="/movies/destroy/<%= movie._id %>" onclick="return confirm('Are you sure?')" class="btn-custom" style="background-color: #ef4444; color: white; padding: 0.4rem 0.6rem; font-size: 0.85rem;">Delete</a>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } else { %>
        <div class="empty-card">
            <p>No movies found.</p>
        </div>
    <% } %>

</div>

<%- include('../../partials/siteFooter') %>