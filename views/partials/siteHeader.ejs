<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MoviesHub — <%= typeof pageTitle !== 'undefined' ? pageTitle : 'Modern Cinema Experience' %></title>

    <!-- Google Fonts: Luxury Modern Duo (Outfit for Headings + Plus Jakarta Sans for Body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">

    <!-- Custom Luxury Dark Styles -->
    <link rel="stylesheet" href="/css/siteStyles.css">
</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark navbar-custom py-2 px-3">
        <div class="container d-flex justify-content-between align-items-center">
            <!-- Brand Name (Luxury typography) -->
            <a class="navbar-brand brand-title" href="/movies">
                <span class="brand-movies">Movies</span><span class="brand-hub">Hub</span>
            </a>

            <div class="d-flex align-items-center gap-3">
                <% if (typeof currentUser !== 'undefined' && currentUser) { %>
                    <span class="text-light d-none d-sm-inline" style="font-size: 0.92rem;">
                        Welcome, <strong><%= currentUser.username %></strong>
                        <% if (currentUser.role === 'admin') { %>
                            <span class="badge bg-danger ms-1" style="font-size: 0.72rem;">Admin</span>
                        <% } %>
                    </span>

                    <% if (currentUser.role === 'admin') { %>
                        <a href="/movies/new" class="btn btn-sm btn-primary-custom">+ Add Movie</a>
                    <% } %>

                    <a href="/auth/logout" class="btn btn-sm btn-outline-danger">Sign Out</a>
                <% } else { %>
                    <a href="/auth/login" class="btn btn-sm btn-outline-light">Sign In</a>
                    <a href="/auth/register" class="btn btn-sm btn-primary-custom">Get Started</a>
                <% } %>
            </div>
        </div>
    </nav>
    <div style="height: 10px;"></div>
